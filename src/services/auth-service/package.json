{
  "name": "miniverse-backend",
  "version": "1.0.0",
  "description": "MiniVerse backend - plataforma de reseñas de series por episodio",
  "scripts": {
    "dev": "ts-node-dev --respawn main.ts",
    "build": "tsc",
    "start": "node dist/main.ts",
    "prisma:generate": "prisma generate --schema=src/auth-service/infrastructure/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/auth-service/infrastructure/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/auth-service/infrastructure/prisma/schema.prisma",
    "keys:generate": "bash generate-keys.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
