generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tablas de otros servicios (no tocar) ───────────────
model Usuario {
  id         Int        @id @default(autoincrement())
  nombre     String     @db.VarChar(100)
  correo     String     @unique @db.VarChar(150)
  contrasena String     @db.VarChar(255)
  edad       Int
  creadoEn   DateTime   @default(now()) @map("creado_en")
  resenas    Resena[]
  comentarios Comentario[]

  @@map("usuario")
}

model Genero {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)
  series Serie[]

  @@map("genero")
}

model Director {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique @db.VarChar(100)
  biografia String? @db.Text
  series    Serie[]

  @@map("director")
}

model Serie {
  id         Int         @id @default(autoincrement())
  tmdbId     Int?        @unique @map("tmdb_id")
  nombre     String      @db.VarChar(150)
  estreno    Int
  sinopsis   String      @db.Text
  idGenero   Int         @map("id_genero")
  idDirector Int         @map("id_director")
  imagenUrl  String?     @db.VarChar(255) @map("imagen_url")
  genero     Genero      @relation(fields: [idGenero], references: [id])
  director   Director    @relation(fields: [idDirector], references: [id])
  temporadas Temporada[]

  @@map("serie")
}

model Temporada {
  id          Int        @id @default(autoincrement())
  numero      Int
  nombre      String     @db.VarChar(150)
  descripcion String?    @db.Text
  imagenUrl   String?    @db.VarChar(255) @map("imagen_url")
  idSerie     Int        @map("id_serie")
  serie       Serie      @relation(fields: [idSerie], references: [id])
  capitulos   Capitulo[]

  @@map("temporada")
}

model Capitulo {
  id          Int        @id @default(autoincrement())
  titulo      String     @db.VarChar(200)
  numero      Int
  duracion    Int
  idTemporada Int        @map("id_temporada")
  temporada   Temporada  @relation(fields: [idTemporada], references: [id])
  resenas     Resena[]

  @@map("capitulo")
}

model Resena {
  id            Int          @id @default(autoincrement())
  contenido     String       @db.Text
  fechaCreacion DateTime     @default(now()) @map("fecha_creacion")
  idCapitulo    Int          @map("id_capitulo")
  idUsuario     Int          @map("id_usuario")
  capitulo      Capitulo     @relation(fields: [idCapitulo], references: [id])
  usuario       Usuario      @relation(fields: [idUsuario], references: [id])
  comentarios   Comentario[]

  @@map("resena")
}

// ── Tablas propias del comment-service ────────────────
model Comentario {
  id            Int      @id @default(autoincrement())
  contenido     String   @db.Text
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")
  idUsuario     Int      @map("id_usuario")
  idResena      Int      @map("id_resena")
  usuario       Usuario  @relation(fields: [idUsuario], references: [id])
  resena        Resena   @relation(fields: [idResena], references: [id])

  @@map("comentario")
}
